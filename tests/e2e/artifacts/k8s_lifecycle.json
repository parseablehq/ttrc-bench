{
 "bootstrap": [
  [
   "helm",
   "pull",
   "store",
   "--repo",
   "https://charts.fx.invalid/store",
   "--version",
   "1.0.0",
   "--destination",
   "<repo>/.otb/charts"
  ],
  [
   "helm",
   "pull",
   "collector",
   "--repo",
   "https://charts.fx.invalid/collector",
   "--version",
   "0.1.0",
   "--destination",
   "<repo>/.otb/charts"
  ],
  [
   "helm",
   "plugin",
   "list"
  ],
  [
   "helm",
   "plugin",
   "install",
   "<repo>/deploy/k8s/stacks/no-liveness"
  ]
 ],
 "up": [
  [
   "kubectl",
   "apply",
   "-f",
   "-"
  ],
  [
   "helm",
   "template",
   "k1-store",
   "<repo>/.otb/charts/store-1.0.0.tgz",
   "--namespace",
   "otb-k1",
   "-f",
   "<repo>/deploy/k8s/stacks/k1-alpha/store.yaml",
   "-f",
   "<repo>/.otb/k8s/values/kind/k1-store.yaml",
   "--post-renderer",
   "no-liveness"
  ],
  [
   "helm",
   "history",
   "k1-store",
   "--namespace",
   "otb-k1",
   "-o",
   "json"
  ],
  [
   "helm",
   "upgrade",
   "--install",
   "k1-store",
   "<repo>/.otb/charts/store-1.0.0.tgz",
   "--namespace",
   "otb-k1",
   "--create-namespace",
   "-f",
   "<repo>/deploy/k8s/stacks/k1-alpha/store.yaml",
   "-f",
   "<repo>/.otb/k8s/values/kind/k1-store.yaml",
   "--post-renderer",
   "no-liveness",
   "--wait",
   "--wait-for-jobs",
   "--timeout",
   "15m"
  ],
  [
   "helm",
   "template",
   "k1-ingest",
   "<repo>/.otb/charts/collector-0.1.0.tgz",
   "--namespace",
   "otb-k1",
   "-f",
   "<repo>/deploy/k8s/stacks/k1-alpha/ingest.yaml",
   "-f",
   "<repo>/.otb/k8s/values/kind/k1-ingest.yaml",
   "--post-renderer",
   "no-liveness"
  ],
  [
   "helm",
   "history",
   "k1-ingest",
   "--namespace",
   "otb-k1",
   "-o",
   "json"
  ],
  [
   "helm",
   "upgrade",
   "--install",
   "k1-ingest",
   "<repo>/.otb/charts/collector-0.1.0.tgz",
   "--namespace",
   "otb-k1",
   "--create-namespace",
   "-f",
   "<repo>/deploy/k8s/stacks/k1-alpha/ingest.yaml",
   "-f",
   "<repo>/.otb/k8s/values/kind/k1-ingest.yaml",
   "--post-renderer",
   "no-liveness",
   "--wait",
   "--wait-for-jobs",
   "--timeout",
   "15m"
  ],
  [
   "kubectl",
   "apply",
   "-f",
   "-"
  ],
  [
   "kubectl",
   "delete",
   "job",
   "store-setup",
   "--namespace",
   "otb-k2",
   "--ignore-not-found",
   "--wait"
  ],
  [
   "kubectl",
   "apply",
   "--namespace",
   "otb-k2",
   "-f",
   "<repo>/deploy/k8s/stacks/k2-beta/store-kind.yaml"
  ],
  [
   "kubectl",
   "rollout",
   "status",
   "statefulset/store",
   "--namespace",
   "otb-k2",
   "--timeout",
   "15m"
  ],
  [
   "kubectl",
   "get",
   "job",
   "store-setup",
   "--namespace",
   "otb-k2",
   "-o",
   "json"
  ],
  [
   "helm",
   "template",
   "k2-ingest",
   "<repo>/.otb/charts/collector-0.1.0.tgz",
   "--namespace",
   "otb-k2",
   "-f",
   "<repo>/deploy/k8s/stacks/k2-beta/ingest.yaml",
   "-f",
   "<repo>/.otb/k8s/values/kind/k2-ingest.yaml",
   "--post-renderer",
   "no-liveness"
  ],
  [
   "helm",
   "history",
   "k2-ingest",
   "--namespace",
   "otb-k2",
   "-o",
   "json"
  ],
  [
   "helm",
   "upgrade",
   "--install",
   "k2-ingest",
   "<repo>/.otb/charts/collector-0.1.0.tgz",
   "--namespace",
   "otb-k2",
   "--create-namespace",
   "-f",
   "<repo>/deploy/k8s/stacks/k2-beta/ingest.yaml",
   "-f",
   "<repo>/.otb/k8s/values/kind/k2-ingest.yaml",
   "--post-renderer",
   "no-liveness",
   "--wait",
   "--wait-for-jobs",
   "--timeout",
   "15m"
  ]
 ],
 "up_readiness": [
  "/k1/k8s/ready",
  "/k2/k8s/ready"
 ],
 "down": [
  [
   "helm",
   "--kube-context",
   "kind-otb-w2",
   "uninstall",
   "k1-ingest",
   "--namespace",
   "otb-k1",
   "--ignore-not-found",
   "--wait"
  ],
  [
   "helm",
   "--kube-context",
   "kind-otb-w2",
   "uninstall",
   "k1-store",
   "--namespace",
   "otb-k1",
   "--ignore-not-found",
   "--wait"
  ],
  [
   "helm",
   "--kube-context",
   "kind-otb-w2",
   "uninstall",
   "k2-ingest",
   "--namespace",
   "otb-k2",
   "--ignore-not-found",
   "--wait"
  ],
  [
   "kubectl",
   "--context",
   "kind-otb-w2",
   "delete",
   "--namespace",
   "otb-k2",
   "--ignore-not-found",
   "--wait",
   "-f",
   "<repo>/deploy/k8s/stacks/k2-beta/store-kind.yaml"
  ]
 ],
 "down_volumes": [
  [
   "helm",
   "--kube-context",
   "kind-otb-w2",
   "uninstall",
   "k1-ingest",
   "--namespace",
   "otb-k1",
   "--ignore-not-found",
   "--wait"
  ],
  [
   "helm",
   "--kube-context",
   "kind-otb-w2",
   "uninstall",
   "k1-store",
   "--namespace",
   "otb-k1",
   "--ignore-not-found",
   "--wait"
  ],
  [
   "kubectl",
   "--context",
   "kind-otb-w2",
   "delete",
   "pvc",
   "--all",
   "--namespace",
   "otb-k1",
   "--wait"
  ],
  [
   "helm",
   "--kube-context",
   "kind-otb-w2",
   "uninstall",
   "k2-ingest",
   "--namespace",
   "otb-k2",
   "--ignore-not-found",
   "--wait"
  ],
  [
   "kubectl",
   "--context",
   "kind-otb-w2",
   "delete",
   "--namespace",
   "otb-k2",
   "--ignore-not-found",
   "--wait",
   "-f",
   "<repo>/deploy/k8s/stacks/k2-beta/store-kind.yaml"
  ],
  [
   "kubectl",
   "--context",
   "kind-otb-w2",
   "delete",
   "pvc",
   "--all",
   "--namespace",
   "otb-k2",
   "--wait"
  ]
 ]
}
