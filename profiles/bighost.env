# Big host for the 1 TB run: every stack gets 8 CPU / 32 GiB across its backend containers, and the same
# 2 CPU / 2 GiB ingest collector. Same keys as laptop.env.
INGEST_CPUS=2
INGEST_MEM=2g

B1_PROMETHEUS_CPUS=2
B1_PROMETHEUS_MEM=10g
B1_PROMETHEUS_RETENTION_SIZE=400GB
B1_LOKI_CPUS=2
B1_LOKI_MEM=8g
B1_TEMPO_CPUS=3
B1_TEMPO_MEM=12g
B1_GRAFANA_CPUS=1
B1_GRAFANA_MEM=2g

B3_CLICKHOUSE_CPUS=8
B3_CLICKHOUSE_MEM=32g
B3_MAX_QUERY_MEMORY=16000000000
B3_SPILL_BYTES=8000000000

B4_PARSEABLE_CPUS=8
B4_PARSEABLE_MEM=32g
B4_QUERY_MEMORY_LIMIT=16000000000
B4_WORKERS=8
B4_TARGET_PARTITIONS=8
