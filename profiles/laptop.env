# Laptop: OrbStack 12 CPU / 16 GB, sharing the host with a few GB of other containers.
# Every stack gets 2 CPU / 2.5 GiB across its backend containers, and the same 0.5 CPU / 256 MiB ingest collector.
# `otb doctor` refuses unequal per-stack sums.
INGEST_CPUS=0.5
INGEST_MEM=256m

B1_PROMETHEUS_CPUS=0.5
B1_PROMETHEUS_MEM=640m
B1_PROMETHEUS_RETENTION_SIZE=8GB
B1_LOKI_CPUS=0.5
B1_LOKI_MEM=640m
B1_TEMPO_CPUS=0.5
B1_TEMPO_MEM=768m
B1_GRAFANA_CPUS=0.5
B1_GRAFANA_MEM=512m

B3_CLICKHOUSE_CPUS=2
B3_CLICKHOUSE_MEM=2560m
B3_MAX_QUERY_MEMORY=1000000000
B3_SPILL_BYTES=500000000

B4_PARSEABLE_CPUS=2
B4_PARSEABLE_MEM=2560m
B4_QUERY_MEMORY_LIMIT=1000000000
B4_WORKERS=4
B4_TARGET_PARTITIONS=4
